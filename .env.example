# Zoho API Configuration
# Get these from your Zoho API Console (Server-based Application)

# OAuth Client ID
ZOHO_CLIENT_ID=

# OAuth Client Secret (keep this secret!)
ZOHO_CLIENT_SECRET=

# OAuth Refresh Token (obtained via OAuth flow)
# Required scopes: ZohoCRM.modules.leads.CREATE, Desk.tickets.CREATE
ZOHO_REFRESH_TOKEN=

# Zoho API Domain (varies by data center)
# US: www.zohoapis.com | EU: www.zohoapis.eu | IN: www.zohoapis.in | AU: www.zohoapis.com.au
ZOHO_API_DOMAIN=www.zohoapis.com

# Zoho Accounts Domain (for OAuth token refresh)
# US: accounts.zoho.com | EU: accounts.zoho.eu | IN: accounts.zoho.in | AU: accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com

# Zoho Desk Organization ID
# Find this in Zoho Desk > Settings > Developer Space > API
ZOHO_DESK_ORG_ID=

# Zoho Desk Department ID (required for Desk tickets; Desk rejects a ticket without one)
# If unset, /api/contact/support logs "[CRITICAL] ZOHO_DESK_DEPARTMENT_ID missing"
# and sends every request through the email fallback below.
# List the IDs with: npx tsx scripts/get-zoho-desk-departments.ts
ZOHO_DESK_DEPARTMENT_ID=

# Email fallback for /api/contact/sales and /api/contact/support (server-only)
# When Zoho does not take a submission, it is emailed to hello@humaneers.dev
# (sales) or support@humaneers.dev (support) through Zoho Mail SMTP.
# USER is the sending mailbox and the From address; PASS is a Zoho Mail
# app-specific password. Without USER and PASS the fallback is skipped and
# logged as fallback: "unconfigured".
# Port 465 uses implicit TLS; any other port must offer STARTTLS or nothing is sent.
FALLBACK_SMTP_HOST=smtp.zoho.com
FALLBACK_SMTP_PORT=465
FALLBACK_SMTP_USER=
FALLBACK_SMTP_PASS=
